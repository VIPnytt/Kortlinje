{
    "$schema": "./webui/node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "ignoreUnknown": true
    },
    "formatter": {
        "attributePosition": "multiline",
        "expand": "always",
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "tailwind": {
        "stylesheet": "./webui/src/style.css"
    },
    "vcs": {
        "clientKind": "git",
        "enabled": true,
        "useIgnoreFile": true
    }
}
