.program display
.side_set 1
idle:
    pull block          side 1 [2]
    set pins, 0         side 1 [2]
    set pins, 0         side 0 [2]
.wrap_target
byte_loop:
    pull block          side 0
    out x, 1            side 0
    jmp !x do_data      side 0
    set pins, 0         side 0 [2]
    set pins, 0         side 1 [2]
    set pins, 1         side 1 [3]
    jmp idle            side 1
do_data:
    set y, 7            side 0
bit_loop:
    out pins, 1         side 0
    nop                 side 1 [1]
    jmp y-- bit_loop    side 0
.wrap
