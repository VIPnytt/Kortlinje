.program vk1640
.side_set 1
.wrap_target
idle:
    pull block          side 1
    set pins, 1         side 1 [1]
    set pins, 0         side 1 [1]
    set pins, 0         side 0 [1]
byte_loop:
    pull block          side 0
    out x, 1            side 0
    jmp !x do_data      side 0
    set pins, 0         side 0 [1]
    set pins, 0         side 1 [1]
    set pins, 1         side 1 [1]
    jmp idle            side 1
do_data:
    set y, 7            side 0
bit_loop:
    out pins, 1         side 0 [1]
    nop                 side 1 [1]
    jmp y-- bit_loop    side 0
    jmp byte_loop       side 0
.wrap
