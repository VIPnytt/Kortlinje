.program climate
.wrap_target
idle:
    set pins, 0
    pull block
    mov y, osr
    set pins, 1
wait_sync:
    wait 1 pin 0
    wait 0 pin 0
    set x, 19
sync_loop:
    jmp pin wait_sync
    jmp x-- sync_loop [1]
    wait 1 pin 0
bit_loop:
    wait 0 pin 0 [22]
    in pins, 1
    wait 1 pin 0
    jmp y-- bit_loop
    push block
    irq set 0
.wrap
