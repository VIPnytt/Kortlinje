.program photocell
    mov    osr, null
.wrap_target
poll:
    set    x, 31
outer:
    set    y, 31
inner:
    jmp    y--, inner             [31]
    jmp    x--, outer
    mov    isr, null
    in     pins, 1
    mov    y, isr
    mov    x, osr
    jmp    x != y, change
.wrap
change:
    mov    osr, y
    push   noblock
    irq    nowait 1
    jmp    poll

.program photocell_e9
    mov    osr, null
.wrap_target
    set    x, 31
outer:
    set    y, 31
inner:
    jmp    y--, inner             [31]
    jmp    x--, outer
    mov    isr, null
    in     pins, 1
    mov    y, isr
    mov    x, osr
    jmp    x != y, change
clamp:
    set    pindirs, 1
    set    pindirs, 0
.wrap
change:
    mov    osr, y
    push   noblock
    irq    nowait 1
    jmp    clamp
